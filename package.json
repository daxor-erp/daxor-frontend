{
  "name": "daxor-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "codegen": "graphql-codegen --config codegen.ts && node scripts/fix-codegen.js && node -e \"const fs=require('fs');const f='gql/gql.ts';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace('const documents = [];','const documents: any[] = [];'))\"",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test e2e/auth-login.spec.ts",
    "test:e2e:sales": "playwright test e2e/sales-flow.spec.ts --workers=1",
    "test:e2e:accounting": "playwright test e2e/accounting-ar.spec.ts --workers=1",
    "test:e2e:sales-accounting": "playwright test e2e/sales-flow.spec.ts e2e/accounting-ar.spec.ts --workers=1",
    "test:e2e:payables": "playwright test e2e/payables-flow.spec.ts --workers=1",
    "test:e2e:inventory-debit": "playwright test e2e/inventory-debit-flow.spec.ts --workers=1",
    "test:e2e:flows": "playwright test e2e/sales-flow.spec.ts e2e/accounting-ar.spec.ts e2e/payables-flow.spec.ts e2e/inventory-debit-flow.spec.ts e2e/crm-flow.spec.ts e2e/customers-banks-flow.spec.ts e2e/inventory-flow.spec.ts e2e/payroll-flow.spec.ts e2e/production-flow.spec.ts --workers=1",
    "test:e2e:flows:all": "playwright test e2e/auth-login.spec.ts e2e/sales-flow.spec.ts e2e/accounting-ar.spec.ts e2e/payables-flow.spec.ts e2e/inventory-debit-flow.spec.ts e2e/crm-flow.spec.ts e2e/customers-banks-flow.spec.ts e2e/inventory-flow.spec.ts e2e/payroll-flow.spec.ts e2e/production-flow.spec.ts --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:pdf-images": "node scripts/pdf-flow-to-images.mjs",
    "e2e:pdf-images:all": "node scripts/pdf-flow-to-images.mjs --all",
    "test:e2e:crm": "playwright test e2e/crm-flow.spec.ts --workers=1",
    "test:e2e:customers-banks": "playwright test e2e/customers-banks-flow.spec.ts --workers=1",
    "test:e2e:vendors": "playwright test e2e/vendors-flow.spec.ts --workers=1",
    "test:e2e:products": "playwright test e2e/products-flow.spec.ts --workers=1",
    "test:e2e:purchase-orders": "playwright test e2e/purchase-orders-flow.spec.ts --workers=1",
    "test:e2e:inventory-flow": "playwright test e2e/inventory-flow.spec.ts --workers=1",
    "test:e2e:payroll": "playwright test e2e/payroll-flow.spec.ts --workers=1",
    "test:e2e:production": "playwright test e2e/production-flow.spec.ts --workers=1",
    "test:e2e:flows:remaining": "playwright test e2e/crm-flow.spec.ts e2e/customers-banks-flow.spec.ts e2e/inventory-flow.spec.ts e2e/payroll-flow.spec.ts e2e/production-flow.spec.ts --workers=1"
  },
